{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tools/**/*.ts", "vitest.config.ts"]
}
